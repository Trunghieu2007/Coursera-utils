{
  "manifest_version": 3,
  "name": "Coursera Copy Questions",
  "version": "1.14.0",
  "description": "Copy Coursera questions, skip every completable item, and show progress.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/*"
      ],
      "js": [
        "content.js",
        "overview.js",
        "video.js",
        "readings.js",
        "discussions.js",
        "plugins.js",
        "skipall.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://d10o6em2qtnr4q.cloudfront.net/assets/*/index.html"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Copy Questions",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
