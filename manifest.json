{
  "manifest_version": 3,
  "name": "Coursera Copy Questions",
  "version": "1.3.0",
  "description": "Copy the questions visible on a Coursera lesson page to the clipboard as JSON, and mark the lecture videos of a course as completed.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/learn/*"
      ],
      "js": [
        "content.js",
        "video.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Copy Questions",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
