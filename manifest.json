{
  "manifest_version": 3,
  "name": "Coursera Helper",
  "version": "1.16.0",
  "description": "Helps you rush through courses efficiently.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "clipboardWrite",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/*"
      ],
      "js": [
        "content.js",
        "overview.js",
        "video.js",
        "readings.js",
        "discussions.js",
        "plugins.js",
        "skipall.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://d10o6em2qtnr4q.cloudfront.net/assets/*/index.html"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Coursera Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
